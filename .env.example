# Credenciales de Postgres para docker-compose.
# Copiar a .env en la raíz del proyecto y ajustar si querés otra contraseña.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=placas_deteccion_robo

# Secret para firmar los JWT del backend. Obligatorio: el backend no arranca
# sin esta variable. Generar uno propio, por ejemplo con:
#   openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
