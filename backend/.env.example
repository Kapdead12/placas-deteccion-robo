DATABASE_URL="postgresql://postgres:postgres@localhost:5432/placas_deteccion_robo?schema=public"
ML_SERVICE_URL="http://localhost:8000"
PORT=3001
# Obligatorio: el backend no arranca sin esta variable. Generar uno propio,
# por ejemplo con: openssl rand -base64 48
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"
# Confianza mínima de OCR (0-1) para cruzar la lectura contra placas_reportadas
# y disparar una alerta. Por debajo de esto, la detección se guarda igual
# pero nunca se marca como "reportada". Opcional, default 0.5.
MIN_OCR_CONFIANZA_ALERTA=0.5
